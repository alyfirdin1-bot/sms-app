<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CaptchaPay Deposit SMS Gateway"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Status: Checking..."
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Permissions Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permissions &amp; Background Health"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGrantPermissions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grant SMS &amp; All Perms"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnBatteryOptimize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ignore Battery Opt"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Server Connection Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Deposit Server Connection"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPasteConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste Admin JSON"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#020617"
                android:hint="https://your-server-url"
                android:inputType="textUri"
                android:padding="10dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etGatewayToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#020617"
                android:hint="Permanent Deposit API Key (from Admin Panel)"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#020617"
                android:hint="Device Name (e.g., Admin bKash Phone)"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/swPaymentOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Filter: Forward MFS/Payment SMS Only (bKash/Nagad/Rocket/USDT)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save &amp; Start Monitor"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnStopService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestHeartbeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Test Connection"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnPreviewLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Login Preview URL"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPreviewCookieStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Preview Session: Checking..."
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Custom Test SMS (Amount & TrxID) Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test SMS Simulator (Check Server Receive)"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enter Amount &amp; TrxID below to test if your SMS reaches the Deposit Server."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/rgTestMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMethodBkash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="bKash"
                    android:textColor="#F472B6"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMethodNagad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nagad"
                    android:textColor="#FB923C"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMethodRocket"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rocket"
                    android:textColor="#C084FC"
                    android:textSize="12sp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTestAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#020617"
                    android:hint="Amount (e.g. 500)"
                    android:inputType="numberDecimal"
                    android:padding="10dp"
                    android:text="500"
                    android:textColor="#34D399"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/etTestTrxId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:background="#020617"
                    android:hint="TrxID (e.g. CHK998877)"
                    android:inputType="textCapCharacters"
                    android:padding="10dp"
                    android:textColor="#FBBF24"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etTestSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#020617"
                android:hint="Sender Phone (e.g. 01712345678)"
                android:inputType="phone"
                android:padding="10dp"
                android:text="01712345678"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTestSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send Test SMS to Server"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Captured SMS Monitor Log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live SMS Gateway Logs (This Phone)"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="No SMS captured yet."
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
